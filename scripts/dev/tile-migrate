#!/usr/bin/env python3
"""Tile migrations on the shared LAN farm: edit existing tiles without regenerating them.

Usage: scripts/dev/tile-migrate register --base bulkgen2-3d1445b2 [--ref HEAD] [--alias NAME]
       scripts/dev/tile-migrate apply --version ALIAS t0_0_0 t0_1_0     (foreground, a few tiles)
       scripts/dev/tile-migrate run --version ALIAS [--jobs 6] [--watch 60]   (background, city)
       scripts/dev/tile-migrate status --version ALIAS
       scripts/dev/tile-migrate parity --version ALIAS --generated GENERATOR_ALIAS t0_12_-12

``register`` uploads the committed snapshot, derives the migrated generation from the base and
the snapshot's chain (pipeline/turku3d/migrations/registry.py) and registers the alias
(default ``<base alias>+m<generation[:8]>``). It never repins the game.
"""
import argparse
import json
import shlex
import subprocess
from urllib.request import Request, urlopen

from shared_tile_identity import generation as generator_identity
from shared_tile_snapshot import toplevel, upload


def command(*args):
    return subprocess.check_output(args).decode().strip()


def remote(args, action, *extra, background=False):
    """Run tile_migrate.py on the farm host from the selected snapshot in the pipeline env."""
    q = shlex.quote
    repo = f'{args.root}/revisions/{args.code}/repo'
    work = f'{args.root}/work/migrate'
    line = ' '.join(q(x) for x in ['python', 'scripts/dev/tile_migrate.py', action,
                                    '--farm-root', args.root, *extra])
    env = f'mkdir -p {q(work)} && REPO={q(repo)} TURKU3D_WORK={q(work)} {q(args.runner)} '
    if background:
        log = f'{args.root}/logs/migrate-{args.code[:12]}-{action}.log'
        script = f'{env}{line} >> {q(log)} 2>&1 < /dev/null & echo $!'
        return command('ssh', args.host, f'setsid sh -c {q(script)}')
    return subprocess.run(['ssh', args.host, env + line], check=False).returncode


def resolve(args, selector):
    health = json.load(urlopen(args.url + '/health', timeout=10))
    return health['aliases'].get(selector, selector)


def code_of(args, revision):
    meta = command('ssh', args.host, f'cat {shlex.quote(args.root)}/revisions/{revision}/revision.json')
    return json.loads(meta)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--host', default='osgallery-dev')
    parser.add_argument('--url', default='http://192.168.1.114:7950')
    parser.add_argument('--root', default='/home/wnt/turku3d-local/loops/tiles/farm')
    parser.add_argument('--runner', default='/home/wnt/turku3d-local/loops/tiles/shared-tiles-run.sh')
    sub = parser.add_subparsers(dest='action', required=True)
    register = sub.add_parser('register')
    register.add_argument('--base', required=True, help='alias or revision of the base generation')
    register.add_argument('--ref', default='HEAD')
    register.add_argument('--alias')
    for name in ('apply', 'run', 'status', 'parity'):
        p = sub.add_parser(name)
        p.add_argument('--version', required=True, help='migrated alias or revision')
        if name != 'status':
            p.add_argument('tiles', nargs='*')
        if name == 'parity':
            p.add_argument('--generated', required=True,
                           help='alias of the generator at the migration commit, same source version')
        if name in ('apply', 'run'):
            p.add_argument('--code', help='newer runner snapshot (git ref); its transform code must match')
        if name == 'run':
            p.add_argument('--jobs', type=int, default=6)
            p.add_argument('--watch', type=float, default=0, help='rescan the base every N seconds')
    args = parser.parse_args()
    if args.action == 'register':
        args.code = command('git', 'rev-parse', args.ref + '^{commit}')
        upload(args.code, dict(revision=args.code, generation=generator_identity(args.code, cwd=toplevel()),
                               branch=command('git', 'rev-parse', '--abbrev-ref', 'HEAD'),
                               purpose='tile-migration code'), host=args.host, root=args.root)
        base = resolve(args, args.base)
        derived = json.loads(command('ssh', args.host, ' '.join([
            f'mkdir -p {shlex.quote(args.root)}/work/migrate &&',
            f'REPO={shlex.quote(args.root)}/revisions/{args.code}/repo',
            f'TURKU3D_WORK={shlex.quote(args.root)}/work/migrate', shlex.quote(args.runner),
            'python scripts/dev/tile_migrate.py derive --farm-root', shlex.quote(args.root),
            '--base', base, '--code', args.code])).splitlines()[-1])
        alias = args.alias or f"{args.base}+m{derived['generation'][:8]}"
        body = json.dumps(dict(revision=derived['revision'], alias=alias)).encode()
        registered = json.load(urlopen(Request(args.url + '/register', data=body,
                                               headers={'Content-Type': 'application/json'})))
        print(json.dumps(dict(registered, base_revision=derived['base_revision'],
                              base_generation=derived['base_generation'], code_revision=args.code,
                              migrations=derived['migrations'])))
        print(f'Tile endpoint: {args.url}/v/{alias}/coarse/')
        return 0
    revision = resolve(args, args.version)
    meta = code_of(args, revision)
    if meta.get('kind') != 'migrated':
        raise SystemExit(f'{args.version} is not a migrated revision')
    if getattr(args, 'code', None):
        args.code = command('git', 'rev-parse', args.code + '^{commit}')
        upload(args.code, dict(revision=args.code, generation=generator_identity(args.code, cwd=toplevel()),
                               branch=command('git', 'rev-parse', '--abbrev-ref', 'HEAD'),
                               purpose='tile-migration code'), host=args.host, root=args.root)
    else:
        args.code = meta['code_revision']
    if args.action == 'status':
        return remote(args, 'status', '--revision', revision)
    if args.action == 'apply':
        return remote(args, 'apply', '--revision', revision, *args.tiles)
    if args.action == 'parity':
        return remote(args, 'parity', '--revision', revision, '--generated',
                      resolve(args, args.generated), *args.tiles)
    extra = ['--revision', revision, '--jobs', str(args.jobs), *args.tiles]
    if args.watch:
        extra += ['--watch', str(args.watch)]
    pid = remote(args, 'run', *extra, background=True)
    print(json.dumps(dict(started=pid, revision=revision, log=f'{args.root}/logs/migrate-{args.code[:12]}-run.log',
                          status=f"{args.root}/migrations/{meta['generation']}/status.json")))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
