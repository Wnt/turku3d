#!/usr/bin/env python3
"""Create and inspect isolated agent worktrees."""
import argparse
import subprocess
import sys

import sandbox as s


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    subs = ap.add_subparsers(dest='cmd', required=True)
    for cmd in ('new', 'path', 'env', 'rm'):
        p = subs.add_parser(cmd)
        p.add_argument('name')
        if cmd == 'new':
            p.add_argument('--from', dest='ref', default='main')
        if cmd == 'rm':
            p.add_argument('--force', action='store_true')
    subs.add_parser('ls')
    subs.add_parser('gc')
    a = ap.parse_args()
    if a.cmd == 'new':
        print(s.new(a.name, a.ref))
    elif a.cmd == 'path':
        print(s.sandbox(a.name) / 'repo')
    elif a.cmd == 'env':
        print((s.sandbox(a.name) / 'sandbox.env').read_text(), end='')
    elif a.cmd == 'rm':
        s.remove(a.name, a.force)
    elif a.cmd == 'ls':
        s.list_sandboxes()
    else:
        s.gc()


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as e:
        print(f'wt: {e}' + (f'\n{e.stderr}' if isinstance(e, subprocess.CalledProcessError) else ''), file=sys.stderr)
        sys.exit(1)
