#!/usr/bin/env python3
"""Create and inspect isolated agent worktrees."""

import argparse
import os
import subprocess
import sys

import sandbox as s
from env_sync import sync


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    subs = ap.add_subparsers(dest="cmd", required=True)
    for cmd in ("new", "path", "env", "rm"):
        p = subs.add_parser(cmd)
        p.add_argument("name")
        if cmd == "new":
            p.add_argument("--from", dest="ref", default="main")
        if cmd == "rm":
            p.add_argument("--force", action="store_true")
    p = subs.add_parser("sync-env")
    p.add_argument("name", nargs="?")
    p.add_argument("--all", action="store_true")
    subs.add_parser("ls")
    subs.add_parser("du")
    subs.add_parser("prune-landed")
    subs.add_parser("gc")
    a = ap.parse_args()
    if a.cmd == "new":
        print(s.new(a.name, a.ref))
    elif a.cmd == "path":
        print(s.sandbox(a.name) / "repo")
    elif a.cmd == "env":
        print((s.sandbox(a.name) / "sandbox.env").read_text(), end="")
    elif a.cmd == "rm":
        freed = s.remove(a.name, a.force)
        print(f"{a.name}: removed; freed {freed} bytes ({s.format_bytes(freed)})")
    elif a.cmd == "sync-env":
        if a.all and a.name:
            ap.error("choose a name or --all")
        names = sorted(s.registry()) if a.all else [a.name] if a.name else []
        targets = [s.sandbox(name) / "repo" for name in names] if names else [s.REPO]
        for repo in targets:
            env_file = repo.parent / "sandbox.env"
            env = {**os.environ, **(s.read_env(env_file) if env_file.exists() else {})}
            result = sync(repo, env)
            print(f"{repo}: env-sync {result['status']} ({result['seconds']}s)\n{result['output']}")
            if result["status"] == "FAIL":
                raise ValueError("environment sync failed")
    elif a.cmd == "ls":
        s.list_sandboxes()
    elif a.cmd == "du":
        s.du()
    elif a.cmd == "prune-landed":
        s.prune_landed()
    else:
        s.gc()


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as e:
        print(
            f"wt: {e}" + (f"\n{e.stderr}" if isinstance(e, subprocess.CalledProcessError) else ""),
            file=sys.stderr,
        )
        sys.exit(1)
