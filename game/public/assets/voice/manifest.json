 },
 "lines": [
  {
   "id": "intro_1",
   "speaker": "narrator",
   "file": "intro_1.ogg",
   "seconds": 8.845,
   "text": "Turku, 2027. Last month you were a software developer. Then came the redundancy talks, and thousands of jobs like yours went to AI.",
   "textSha256": "08d47301cf96712644561c1be4f308ebbe58a09fc5a4a15a6abfa3779ef84ad5",
   "key": "bc2f6610bb5c1bcecfe986d2de19a2e6531ce68888bbd86850339d7571b522c5",
   "fileSha256": "24ca74c6f2d181d6a1a716c6bda1ec03ee2db9257f5c6e8565e16d1975e4bd7b"
  },
  {
   "id": "intro_2",
   "speaker": "narrator",
   "file": "intro_2.ogg",
   "seconds": 9.098,
   "text": "The austerity package abolished unemployment benefits, earnings-related and basic alike. The only work left is the work robots cannot yet do on their own.",
   "textSha256": "0c91505bad1c097d8256601a8cfeda76a764d8a0a5bc6568dc70234c9e590176",
   "key": "73170617be8793587c680316bf401a6c99e76ae6a3f4d1ccd727feeeafc29c05",
   "fileSha256": "285e9db71f74ab3ed7dbb267e12a24bebcff75e0a46581bdfb96d6876a43b684"
  },
  {
   "id": "intro_3",
   "speaker": "narrator",
   "file": "intro_3.ogg",
   "seconds": 10.63,
   "text": "A traditional pizzeria on Linnankatu needs a courier, but first you need a courier permit, and the only ones left are rented out on the black market. You have 120 euros.",
   "textSha256": "c345017ad722f182486f16f7e97653d7da5f4feb439594efe508badb4c586ec4",
   "key": "f02a865a9d20c827a26b162c00710e1bc617f3a8d9ca6fe69cc49df6d124d8fd",
   "fileSha256": "b3c1f8586a2b78136f25d7e4dd0ce7d28038bbb7e625dfb75d362ca60c3315aa"
  },
  {
   "id": "delivery_failed",
   "speaker": "narrator",
   "file": "delivery_failed.ogg",
   "seconds": 2.469,
   "text": "Too slow. The customer cancelled the order.",
   "textSha256": "0d0ee5d611796c40b38135a0e7b38e6dbcad0945643e3bd00bbc3e0f51382441",
   "key": "7cfe233c54c1bf9867d596b6d9b996cb93ffd3d1b849a176cef765441f969307",
   "fileSha256": "74dce5752777c76004889434e9470111059e7863833f3b340481e5801885b650"
  },
  {
   "id": "market_greet",
   "speaker": "market",
   "file": "market_greet.ogg",
   "seconds": 4.977,
   "text": "Welcome to the black market. Permits, plates, spare organs. Keep your voice down.",
   "textSha256": "0108e46c02983e9377249d3d99cb191dbb4177c7c13ce25557e6f60723aaf57b",
   "key": "1831c66694308787bca667071a4190f09406fbb90eb5726542739ab3765f6167",
   "fileSha256": "20199e86bd331a8be934bca8b564f4efc06b656739dbdbb4e8629ba49949b651"
  },
  {
   "id": "market_greet_expired",
   "speaker": "market",
   "file": "market_greet_expired.ogg",
   "seconds": 2.763,
   "text": "Permit ran out already? They always come back.",
   "textSha256": "7438d41581b783eacf338be573fafa9d26223cf14e3c361a601499ff26378213",
   "key": "7b176b3ddc6318ca0deb5685013bbdb5cc7f721d190ad3513bbed227cd64070d",
   "fileSha256": "a05f4f190419517a15cd72161bf4c1674f793b69fce08d97508ec7b32ed75926"
  },
  {
   "id": "market_sold",
   "speaker": "market",
   "file": "market_sold.ogg",
   "seconds": 5.021,
   "text": "Ten deliveries. If the platform asks, you've been riding since 2024.",
   "textSha256": "aff5a65deca2687d2c532bbaf4b9f56a2e1f88db15bc0b32906dfe8068d5307a",
   "key": "44409addfacd6f551e55615e72f4e8b81ad8102bf9dbeaf448b1fedcf570b145",
   "fileSha256": "994a368173c8b31d3a94a578495925e3ea78e7e8ce0f77a4028b52b4abacd818"
  },
  {
   "id": "market_sold_plates",
   "speaker": "market",
   "file": "market_sold_plates.ogg",
   "seconds": 5.11,
   "text": "Fresh plates. Now every car on the street is yours, as far as the platform knows.",
   "textSha256": "f5ae918a72322b1d87999e33cf59550d7107f6f582dc14627111c3ee2b9a410f",
   "key": "e6db6aab389fedcedf3a5fbed79cd532eb539f1944afad25a757b9adf03c52f6",
   "fileSha256": "a193a8224769bf88d402a425fb40ffb88d8614a1697056deb2bb44c827c968bc"
  },
  {
   "id": "market_sold_kidney",
   "speaker": "market",
   "file": "market_sold_kidney.ogg",
   "seconds": 3.488,
   "text": "Four hundred, cash. Take the stairs slowly from now on.",
   "textSha256": "b1ee5708b294893a410dc0eefbb36808237c5c77a74bef8652af585a99b9ef4a",
   "key": "c10f7a8e19e9b07728ee4f2e38de78a4d99282cbfefe91bbb0c6f069a7322195",
   "fileSha256": "65375da216154c12b9c1e729ba28bf86d443f0d8b504314b3ebe0f74aa64035d"
  },
  {
   "id": "market_sold_warning",
   "speaker": "market",
   "file": "market_sold_warning.ogg",
   "seconds": 3.853,
   "text": "There. The platform will warn you again. Nobody ever warns me.",
   "textSha256": "84babdced908e103448b6e8f54e33af13734c60d963059fc41a5395110364525",
   "key": "7fba479a2f35cabaf6c65d9ced486629a0f0d792388cd53b492856a152fb8cc2",
   "fileSha256": "93c55677c149de0a051885bba73d398adca0a07f89fcf7bbf761d019561099b3"
  },
  {
   "id": "market_no_money",
   "speaker": "market",
   "file": "market_no_money.ogg",
   "seconds": 2.402,
   "text": "Cash first, friend. I don't do credit.",
   "textSha256": "aab5b89b159b2efb6e2708ad972b91b0ecca372b40fb74d6f566653bbb016923",
   "key": "843a44f6f2338a672d19d2c5b84f71b1503bfc2874e6e2f49436f498fc438459",
   "fileSha256": "7eb68c1b4c8fdc8200ab7c8487b1022857b41b74db2fb776617602f3547b86f5"
  },
  {
   "id": "pizzeria_first",
   "speaker": "pizzeria",
   "file": "pizzeria_first.ogg",
   "seconds": 4.501,
   "text": "So you're the new courier? Good. Hot pizza, fast legs, no excuses.",
   "textSha256": "7c8aa90e36be8f0efe3321f8a67a2a80c6767aaef7b14538ffe6d58cc1af4189",
   "key": "128ba9d325f92a31d32b8f03adf897ecb189d3abad7e2f839100668cca5e9f62",
   "fileSha256": "e1a493bc65c3c0043e205119d98129e9c0a8be51f05186b1f498965662fddf9f"
  },
  {
   "id": "pizzeria_no_permit",
   "speaker": "pizzeria",
   "file": "pizzeria_no_permit.ogg",
   "seconds": 4.135,
   "text": "No permit, no deliveries. The platform checks everything now.",
   "textSha256": "ed59e5b152b88a309b519362fe4e028db8166107ee0958e74c1b6caebe810831",
   "key": "952f8ac0102b14f79e0ab7b183e669dae3e69fec5a37729c9001b8d42e6abfb2",
   "fileSha256": "0840124e255f14b0f6af366fbff97b32538379aa9265695cdba08889d109e4cf"
  },
  {
   "id": "pizzeria_back",
   "speaker": "pizzeria",
   "file": "pizzeria_back.ogg",
   "seconds": 3.526,
   "text": "Back already? Good, the next one is coming out of the oven.",
   "textSha256": "a546534e6ddc99ed4a5e1a2d933e400a4e5e071753a1d55e53aba906bba72138",
   "key": "fe8cbd2d44019f30ea4035a737d824fcd7d517409aed31f9896c9e238fee6097",
   "fileSha256": "09be1e9e743bfa80e852f03add4966dddcdb6442e2099b803ce3aafb545fb4ab"
  },
  {
   "id": "pizzeria_after_fail",
   "speaker": "pizzeria",
   "file": "pizzeria_after_fail.ogg",
   "seconds": 3.791,
   "text": "Cancelled? The robots never get cancelled. Take the next one.",
   "textSha256": "fc87acc7f889aad2e6085f73bcd0c5ade9b9ce6320c9379a8581d7865a31b7a6",
   "key": "ad12e8d91c73d3d50b92a44ae83e1cf2b3e8551601afc935137617f6cc8c0dc0",
   "fileSha256": "acc21f8a450492265c829ed40dc7b0e9772fd67f0db43e7493409b8bd2acc51d"
  },
  {
   "id": "pizzeria_greet",
   "speaker": "pizzeria",
   "file": "pizzeria_greet.ogg",
   "seconds": 3.172,
   "text": "Hungry, or here to work? Either way, make it quick.",
   "textSha256": "54a02763b385777205e94412089f0f2ba710aeefe58d9934283d3c650f3ae9be",
   "key": "c0cb329d58f7fdc44fd9d68cbed96aee864d15f4b900ccd405252183e9db58b4",
   "fileSha256": "a0e8229b887835426fe65c899752968c46b8c3d2c7de7d052ed6ba797a072119"
  },
  {
   "id": "pizzeria_carrying",
   "speaker": "pizzeria",
   "file": "pizzeria_carrying.ogg",
   "seconds": 3.161,
   "text": "Why are you still here? That pizza is getting cold!",
   "textSha256": "536d41fb5e9395c1c839af657a2ac3d79dfc0899b70610adb409a5b646b0ba70",
   "key": "c703f1659f6ea43d32e7736d237e068734b711cfc3867f3be71d3fda543f1085",
   "fileSha256": "d37b09c5838bafcae15bf8d553ed257a92c12d14062e6c6094fca58d705bef15"
  },
  {
   "id": "pizzeria_slice",
   "speaker": "pizzeria",
   "file": "pizzeria_slice.ogg",
   "seconds": 3.109,
   "text": "Here, eat it on the way. The next order won't wait.",
   "textSha256": "4a2d156799f65c43e361ea64047f86d55965621afdc4663755d14f7c60ae115e",
   "key": "7a60d6ce031adae8eb76696a49b4e2fb6ca3c2467747ae0f53d72cb9d1be6b76",
   "fileSha256": "b19b272e59f28ba7a2dc21731e134795edc9ad547c02e85641569b5156abf155"
  },
  {
   "id": "pizzeria_tip_rules",
   "speaker": "pizzeria",
   "file": "pizzeria_tip_rules.ogg",
   "seconds": 5.335,
   "text": "Beat the par time and they tip up to 8 euros. Take twice as long and they cancel.",
   "textSha256": "26cfdbcda19be794a664e141f0454047556400d7faba08a244fbaf08eac09d8b",
   "key": "d900d663ee21e30c1137d511efdcceffa99ace3c83c33f4902585cc5fe4fa5a2",
   "fileSha256": "e0010201c4240a3155319961f6f0b17274f0bc6d8f058ddeacffad3c5aa27fb1"
  },
  {
   "id": "pizzeria_no_money",
   "speaker": "pizzeria",
   "file": "pizzeria_no_money.ogg",
   "seconds": 3.495,
   "text": "Four euros. This is a pizzeria, not a charity.",
   "textSha256": "b02891d9dc120e01bc8614a8894765c69e3efbecf8598b09bd6da05d03da573f",
   "key": "59111a77d822c461965c2f2d280a29e62b0840b8168636ecad1920f47344eded",
   "fileSha256": "9bbbd6774203f2d6af8e2c5b9133e228279343cd0014ff41c505136710d53d75"
  },
  {
   "id": "pizzeria_handover_1",
   "speaker": "pizzeria",
   "file": "pizzeria_handover_1.ogg",
   "seconds": 4.649,
   "text": "Linnankatu 13a, just up the street. Go, before the cheese sets!",
   "textSha256": "569071ce2b9b25d6fe04c8d50cd2da744dc9e34bcda09671d7a7c68e8ae75c54",
   "key": "e97c82b06513d2edc0f2d6e780c31f1cc20362038f66289bcb760c4a37f19765",
   "fileSha256": "6653530753708c2f96c97bd8b9fe04860f88abbbcbed1e5e5a261a52a8493516"
  },
  {
   "id": "pizzeria_handover_2",
   "speaker": "pizzeria",
   "file": "pizzeria_handover_2.ogg",
   "seconds": 3.878,
   "text": "Aurakatu 1, by the bridge. Don't stop to look at the river.",
   "textSha256": "0f59f9aa80aa81a8b7f347b5b20fe37d71a9b01fedcdf1c8e37fb3dd05bf62d5",
   "key": "6ca5c7a11b1ab71699a259f877716762ea3e7d036b29667e6a0ab746a54c1e1a",
   "fileSha256": "39c8f24fb4514f1fdec3ba0ef5d0eab5e2b9ff89b01f67b1b46ad166a5a80fb2"
  },
  {
   "id": "pizzeria_handover_3",
   "speaker": "pizzeria",
   "file": "pizzeria_handover_3.ogg",
   "seconds": 4.222,
   "text": "Läntinen Rantakatu 3, all the way down the river. Move it!",
   "textSha256": "34b8ba352193776031a7c4ee61df4f33c55303ab8174af39d2c86b604df666f8",
   "key": "47082f0833e95413956e9bce83b12a080c1ac82c0cd0a21069931f21cc68298a",
   "fileSha256": "7b74c78520b52460b7c32cdfe9bf784e0a174f2fe69e2d6d10d7cb06490b72a1"
  },
  {
   "id": "pizzeria_handover_4",
   "speaker": "pizzeria",
   "file": "pizzeria_handover_4.ogg",
   "seconds": 4.646,
   "text": "Kaskenkatu 4a, across the river and up the hill. That's a long one.",
   "textSha256": "4fa4a5e66fb0a0bf47608d705c5d68f2ac87877ab18e86b15db1abaf4c9fce50",
   "key": "14f041804f8363a23b6c1dabf1f1e1319d984a28b3e183a01351825cfd35149b",
   "fileSha256": "089ba8ac7d3471945b07acc7d559cd68459365b94b7085b7f29a27072edba5ba"
  },
  {
   "id": "pizzeria_order_1",
   "speaker": "pizzeria",
   "file": "pizzeria_order_1.ogg",
   "seconds": 3.469,
   "text": "Next one's out of the oven. Go, before the cheese sets!",
   "textSha256": "f4d261465fc8a66dc28816ecee529e56e83a59f28525d1ff09781bf9c5506acd",
   "key": "8e8e75a42116ec66b54522337abaac823de70663e6faafd02e0dde378599e69c",
   "fileSha256": "658d7a94b5b360068a89a88e39bdaaa246d4aedcd2f8489ad0cff4e8fff6cb11"
  },
  {
   "id": "pizzeria_order_2",
   "speaker": "pizzeria",
   "file": "pizzeria_order_2.ogg",
   "seconds": 4.043,
   "text": "Here, hot box, cold street. The address is on the slip. Move it!",
   "textSha256": "5018cf7455bbfcadf9b80136299ce00d10641279ec8c7133e579096744574d70",
   "key": "4434ecc4cf466497542bc50b90e39175fc4313a9b390b3d3f5bf19d33f84ac9c",
   "fileSha256": "b7cb9ade1718c19a68016bede37e0f91c6be66bb32741b94e38e7765fb8b7a79"
  },
  {
   "id": "pizzeria_order_3",
   "speaker": "pizzeria",
   "file": "pizzeria_order_3.ogg",
   "seconds": 3.454,
   "text": "Another one. The robots want this job, so do it fast.",
   "textSha256": "4e56656be43bb0f86f86edf00770007cce5b78c54af5151041e133e0bf467837",
   "key": "240957dc2f9cbeac6740f0c2c8767bc16d1c648ded07b6fd5a9275dd4983f2ea",
   "fileSha256": "7b2e853009814e7b3043219c903269bdd522f15bf3fc682adb8858108168ee2a"
  },
  {
   "id": "pizzeria_order_4",
   "speaker": "pizzeria",
   "file": "pizzeria_order_4.ogg",
   "seconds": 3.533,
   "text": "Take it and run. The customer already tracks you on the app.",
   "textSha256": "5a9fb28d915bc59ed50ddd53496f3aff2a6a648f677b4bef57882c7ef1173038",
   "key": "713951b74e08a8197a5ff923f8430fd1c7353fe0e7c14b3327d5b5d3e8ea014f",
   "fileSha256": "d5bbd3a53f4947d12aa25d60cbbe095f21ab5ea585d7ae5a2b8eb7c0c6bb271b"
  },
  {
   "id": "pizzeria_order_5",
   "speaker": "pizzeria",
   "file": "pizzeria_order_5.ogg",
   "seconds": 3.373,
   "text": "Fresh one. Don't eat it on the way, I count the slices.",
   "textSha256": "301fc64256558717aad8061326c04dbd3fa4e52be07adf23040eca0ab2049817",
   "key": "4ec8e8c8a804627313a3bf50a564e055e77dc470f853c39f3a3befbbf04a5e9c",
   "fileSha256": "85be30e0259faffac7d5d6d7c5b55f4089157280d491747e9eff87cf9e3bd9d1"
  },
  {
   "id": "pizzeria_order_6",
   "speaker": "pizzeria",
   "file": "pizzeria_order_6.ogg",
   "seconds": 2.982,
   "text": "Go, go! Every minute is a euro off your tip.",
   "textSha256": "44834a9c8e03209092a5c3ff8d3a411ff63b042a79112c13e1eca7a138333d48",
   "key": "2d31a32b5e0918f1cd722313f40eb1f83aa6c5d785147cb6609c8588cf246dd5",
   "fileSha256": "d253062a56979a1f25b0ce81ba694d6ca5e6bab653391f15c6651eab09303d9b"
  },
  {
   "id": "dealer_greet",
   "speaker": "dealer",
   "file": "dealer_greet.ogg",
   "seconds": 2.434,
   "text": "Wheels! Bicycles, cars, everything runs. Mostly.",
   "textSha256": "37416e8f8aed9507ae92180bafa3b814c0d87df0e58e05f3c666c4bc9ecac314",
   "key": "3f2718fc2babfca19279364e874831810703a9bcaae47758485a2d7fafb411c8",
   "fileSha256": "e1e80504971a5745c3f442caa15b666f63bfbdc755d91eba17366278aa83551c"
  },
  {
   "id": "dealer_sold_bicycle",
   "speaker": "dealer",
   "file": "dealer_sold_bicycle.ogg",
   "seconds": 3.3,
   "text": "One bicycle, barely ridden. It's waiting for you right by the kerb.",
   "textSha256": "8e108a2a59fbf0426ea0850463c9987b5540a017e94c14a5aafce3e53cce832b",
   "key": "241c50aa9b2db8682725064440df99085425d4eedb18ddab05b19ea8dcf36d6b",
   "fileSha256": "cffe9e2a7f622189e76535bde17276a8d469ffbc84eec9c9b94ffed8426b57e4"
  },
  {
   "id": "dealer_sold_car",
   "speaker": "dealer",
   "file": "dealer_sold_car.ogg",
   "seconds": 2.626,
   "text": "Three hundred and fifty, and she's yours. The keys are in it.",
   "textSha256": "267ff64027902119aba16323e592dee982cecec69f2bdf20d2391b01d9ddd154",
   "key": "e5ca58b194a151daaea9964bfb7e216024609b876e4c25da76568694a9e59097",
   "fileSha256": "6fb25163d80b3a92aa61c190d7ad9f69a56560534cc3a7591c73f1dfdc1955f3"
  },
  {
   "id": "dealer_bought_back",
   "speaker": "dealer",
   "file": "dealer_bought_back.ogg",
   "seconds": 2.701,
   "text": "Half price, take it or leave it. Pleasure doing business.",
   "textSha256": "e23c25a01e21f89596280869b2a96e049ee08ce8cad464764fd2e5cc8e37a225",
   "key": "e64f56092a0284cb01011283d74f85a7caadbedec98362e0122a5bcb566a501b",
   "fileSha256": "90d0f882215fb643e11f198f71826e52fa102164af937dfe7791419f382fe8f7"
  },
  {
   "id": "dealer_no_money",
   "speaker": "dealer",
   "file": "dealer_no_money.ogg",
   "seconds": 2.607,
   "text": "Cash only, friend. Deliver a few more pizzas first.",
   "textSha256": "c79acac79a4da105d1e695b428d0060ad2678009275635da2d23d7db10294ca0",
   "key": "123095c104f641b899b5e837a529b5f053f22aff5c91498c82135e5fce37b177",
   "fileSha256": "8cba7a4b480962887647cb996abadbe653827be663e978d3be0ace7308b4fe28"
  },
  {
   "id": "dealer_no_permit",
   "speaker": "dealer",
   "file": "dealer_no_permit.ogg",
   "seconds": 3.396,
   "text": "No courier permit? Then what do you need wheels for? Come back with one.",
   "textSha256": "a7ab0f47ad060b34092e6caf4c5ebaef01577d5ace40f624b69e5f4568572149",
   "key": "5e544b95f6e5473753f47eac74c2894d40fa2b7058e3ec424e464d275ff3710c",
   "fileSha256": "c5047d7ad1476da62ea5eb707b272c7f8571804e79cdf6256ea9f73ba3b1ef41"
  },
  {
   "id": "customer_1_fast",
   "speaker": "customer",
   "file": "customer_1_fast.ogg",
   "seconds": 2.426,
   "text": "Already? It's still steaming. Keep the change!",
   "textSha256": "7c15545121564794375be5a9986375ed2c80b9c86dc7f87fa0c53522158e0ffb",
   "key": "320d8606f5f71805122e30ae40944a2be893893361f59f816467331970c131a9",
   "fileSha256": "a2d6c1320ff51f97b52f5985f29d052b70d818bdc4c5dbeba96c01b5a3afe28d"
  },
  {
   "id": "customer_1_ok",
   "speaker": "customer",
   "file": "customer_1_ok.ogg",
   "seconds": 1.922,
   "text": "Thanks. Right on time, more or less.",
   "textSha256": "3eac23c348441ebcfc3718cced2f41d360794d2a17a13cd9e8b9053c0189e1dd",
   "key": "718b3ee3eb943064047544cca4de74e561182b9b173c9a3b6802e75587ff3638",
   "fileSha256": "f1e0d2f0eccbf6687919ab74765a1c10112acb89330f374b5a655ed5c8087559"
  },
  {
   "id": "customer_1_slow",
   "speaker": "customer",
   "file": "customer_1_slow.ogg",
   "seconds": 1.94,
   "text": "Finally. It's barely warm, you know.",
   "textSha256": "9674da5589ece7b9bf6a4f4f361d7466298479f3081a1d2449b9613bdeb1683d",
   "key": "85a1b0abc169e94fd08a18410ba1ce5715b5812c1abf04436d63083bea9a1092",
   "fileSha256": "1771b9ce8af36d3665fda6ccc485ecdc598aa65b9521abc28e644ab5421ec261"
  },
  {
   "id": "customer_2_fast",
   "speaker": "customer",
   "file": "customer_2_fast.ogg",
   "seconds": 2.124,
   "text": "That was quick! The app said twenty minutes.",
   "textSha256": "34becf2cf68b6e09bcb9902e7afcfda4caee90b727c17e2bb12a8d07d1084ed9",
   "key": "0da60c81f17b1a238b3f67b84a1bea910446c6525930d349d38fe55249e8bcdd",
   "fileSha256": "f1b4279c705d6b290e3c4bff5cc4dcf39f36bcfb069bedd93535d6f7ca9f7f90"
  },
  {
   "id": "customer_2_ok",
   "speaker": "customer",
   "file": "customer_2_ok.ogg",
   "seconds": 1.594,
   "text": "Thanks, just put it on the step.",
   "textSha256": "880b83250bc11f3a5aafe12862bfa28cf7ffd2ff904d7fcb0f4b9fbbe8e573a9",
   "key": "3e85711c6726f411595b0132ebacca03c77b991580068121f7a36324cee4ed7e",
   "fileSha256": "8c7e98b56e444b536f471d85614514a38e6ce6320ff08741a89f37456f47400a"
  },
  {
   "id": "customer_2_slow",
   "speaker": "customer",
   "file": "customer_2_slow.ogg",
   "seconds": 2.247,
   "text": "The drone next door gets here faster than you.",
   "textSha256": "452a52ce2377475745baf6a689981c6f981a6892f247128c3ab4069596de289e",
   "key": "5523acf01ca9d90fd7237b9b77b949be905c2e3e2b6795143c8d39750559c144",
   "fileSha256": "7b6dc16cfc5804f11be6c7c40ce549a6258e35706fcada1fc084d2863d24370a"
  },
  {
   "id": "customer_3_fast",
   "speaker": "customer",
   "file": "customer_3_fast.ogg",
   "seconds": 3.652,
   "text": "Wow, a human courier, and a fast one. Here, take something extra.",
   "textSha256": "88655bd1a1f5d068c0a3cb267dea9da66bda4371c803ad6a608ec3d50f761ae9",
   "key": "faaf53afd835cffea9576f840bbc1842bf829708e4f97ed5b12fda354f84a475",
   "fileSha256": "6298106ca7f299c912c9491d06f5548b9b7ebf4a8a3473efd41854a461ce1df0"
  },
  {
   "id": "customer_3_ok",
   "speaker": "customer",
   "file": "customer_3_ok.ogg",
   "seconds": 2.316,
   "text": "Good, I was just about to give up on dinner.",
   "textSha256": "b45383bb1e1fa16d97315c7422feba0be19158d4901f6605e3668b6a35c4e6ca",
   "key": "7d29d96da311f5eb6d14012ce51d0a2394b6952a75286e4f5c0a030ac76878bd",
   "fileSha256": "5ec323fffcd15e5e45895fa470e0742a97b8f4a35540bd01865d78b4020dc03d"
  },
  {
   "id": "customer_3_slow",
   "speaker": "customer",
   "file": "customer_3_slow.ogg",
   "seconds": 1.584,
   "text": "Did you walk here from Helsinki?",
   "textSha256": "9804f5946709da61e72ae1705ede0ffcdb4c2ff99b2c6ecbb1da363a17e490aa",
   "key": "427b384786ae9f9cd4dca85dbcd0295fddeb3fdbaf28d0e5d6c910693908511a",
   "fileSha256": "70b45a34ab8b4c09bcb43b52fd473edf2245092b73af1240d31b93df81b73e93"
  },
  {
   "id": "customer_4_fast",
   "speaker": "customer",
   "file": "customer_4_fast.ogg",
   "seconds": 2.458,
   "text": "Up the whole hill already? You deserve a tip.",
   "textSha256": "50e35a81a0afda398763d18a0f483dffbec9949dd9557e37f675a96efc6619d3",
   "key": "67e3948c55cc7abac3619b136c6462a8bd596043d79f9a60fefdbdb73d422ba9",
   "fileSha256": "783195d778bfae8c97143c937da790c829b797e7d6fd5ed4ced314dbda924489"
  },
  {
   "id": "customer_4_ok",
   "speaker": "customer",
   "file": "customer_4_ok.ogg",
   "seconds": 1.863,
   "text": "Long climb, huh? Thanks anyway.",
   "textSha256": "680ea9c9bad8cdcb8afddd9c0235dbbca14ba32755cdb57164a11efea373258b",
   "key": "366670dad801dfdb6c38c68589e0aae472edfd1fc87c7e9a48c557678a583f22",
   "fileSha256": "ce173e727b057d094e1f90487823858ba3633a0563e9e2619f5c2c01a9ea9751"
  },
  {
   "id": "customer_4_slow",
   "speaker": "customer",
   "file": "customer_4_slow.ogg",
   "seconds": 2.482,
   "text": "Cold pizza on a cold evening. Lovely.",
   "textSha256": "46462a842b536da266ba558c357acd611b573d666747438f1baa14d7a4426605",
   "key": "2c7657bd2c097c1a5a100eae3fb5bfe05599e52ceeeb24100e8e6d673198f7f0",
   "fileSha256": "96cd53d23c5821891d078d6c4b4a4c5bb05e6fce70303cb2879f674c8fbc134b"
  },
  {
   "id": "customer_fast_1",
   "speaker": "customer",
   "file": "customer_fast_1.ogg",
   "seconds": 4.153,
   "text": "Already? The delivery robot quoted forty minutes and a software update.",
   "textSha256": "fa9b72a08f994a78fbb182adad40462b694b6077c0259edbd6fc3ed167f41161",
   "key": "eea7f1befbb85d870819e899ba399fcf36026df06b363fe7aac17bc638adba34",
   "fileSha256": "67712d2b0019ca7c03f2e2746703b728bb442855f3777955607f47d75ab5dc7a"
  },
  {
   "id": "customer_fast_2",
   "speaker": "customer",
   "file": "customer_fast_2.ogg",
   "seconds": 2.882,
   "text": "Still hot! Here, a tip. Don't tell the algorithm.",
   "textSha256": "6f4e66d4247a29a08f43c8051f82913b68b29b6d046692655edc7a0a952c4d30",
   "key": "d0681008c6648abc36849eaecff8dfe01a0ebf3f78af36b675bca47cbab22f2b",
   "fileSha256": "1bc4e2e8e9c653992d90c69c97a69a7ee67cd3216659198ad20b645c8106f8e8"
  },
  {
   "id": "customer_fast_3",
   "speaker": "customer",
   "file": "customer_fast_3.ogg",
   "seconds": 2.697,
   "text": "That was fast. Are you sure you're not a drone in a hoodie?",
   "textSha256": "9e76415ff8007feff33e415beed900885cee1969560290d8e069774e4d6f9f71",
   "key": "2227d88b3729e768a9050ab661c5560835ec5a2ff2f85e34b003441a824c74c3",
   "fileSha256": "802b062fd6304964b89ec9f4f5b463b2bb69a41912bc8b2d9b5afcf4da7f278f"
  },
  {
   "id": "customer_fast_4",
   "speaker": "customer",
   "file": "customer_fast_4.ogg",
   "seconds": 4.091,
   "text": "Perfect timing. My standup call just ended, and so did my job.",
   "textSha256": "46fdd97fbb5bb25a262169773351afda337ebcf7411140289e195b881e05d382",
   "key": "82fc48d740b8c2d29bff3836b882f6b6d870653dfed2083524d92e36fd4879ed",
   "fileSha256": "dfd7f0a36a0b20fcc50a04d887d76c122d41c116383a3faab7135dc201400464"
  },
  {
   "id": "customer_fast_5",
   "speaker": "customer",
   "file": "customer_fast_5.ogg",
   "seconds": 3.131,
   "text": "Wow. Take the tip before the austerity package finds it.",
   "textSha256": "ac3d12db4694075430c70babb4fa0c36c22d3dac0f810cd78a728f7ca2594666",
   "key": "45cace45d013025861427cd0644df5215732ebe06f16ef163870cf10885cb307",
   "fileSha256": "365c9f1611d70279c9aed1a33de70ea4ba99ea3e09da922b5bc327aae818644b"
  },
  {
   "id": "customer_fast_6",
   "speaker": "customer",
   "file": "customer_fast_6.ogg",
   "seconds": 3.379,
   "text": "Faster than the tram, and the tram doesn't even run anymore.",
   "textSha256": "9b32f70ce9f7206b0cd233d137fc9ceae7791d2d102444c0f4d56194eacb623e",
   "key": "598b319ebceadfe5b821e6544ee9211d4c5bed8677a5530c97ef4b8e162b61fa",
   "fileSha256": "d2c84566251e82812a457e2d306cbf8a8906fe08040930bbe59acda76a43d63c"
  },
  {
   "id": "customer_fast_7",
   "speaker": "customer",
   "file": "customer_fast_7.ogg",
   "seconds": 2.806,
   "text": "Steaming hot. You must really need the money. Here.",
   "textSha256": "b14af7e0221bb0158e0fed27c9cad8d73a46a75e1c1984b390dabca2f79a694c",
   "key": "2cdb976e87d6d8cd5112098a6096b9b44b5267b7a97a5b53332e61de5dfb727d",
   "fileSha256": "5b6bc51a8f181e2fe858afc06e800df3db0cf72c6136b7d7f5054b0c3d083ade"
  },
  {
   "id": "customer_fast_8",
   "speaker": "customer",
   "file": "customer_fast_8.ogg",
   "seconds": 3.444,
   "text": "You ran here? Respect. My knees retired before I did.",
   "textSha256": "daef1c8f4b7e6deaf53539f691108a6755be9be7abc4dac208fc96875d883d62",
   "key": "061011d41b077fd0b5405e8df1ef7160ed9ffb86536accfedee5cd0fd365bc20",
   "fileSha256": "a3a96bdd3ba40d8a434535283c0e63b7a10242b9802d67d60f98683999065635"
  },
  {
   "id": "customer_fast_9",
   "speaker": "customer",
   "file": "customer_fast_9.ogg",
   "seconds": 3.979,
   "text": "Hot pizza and a human face. That's worth a few euros these days.",
   "textSha256": "10ba74aecea274631d649f4b290eac349e2dee906898a8c4a3b3c646a62f5c2a",
   "key": "d25afeef90e5b3c0189b66359b4c989ea09677cb16952d2357bf8bd86e206c7b",
   "fileSha256": "553d482cf3ffb4859f9554e08461118cc15b0f2fe068e899dad5d25625a1dfeb"
  },
  {
   "id": "customer_fast_10",
   "speaker": "customer",
   "file": "customer_fast_10.ogg",
   "seconds": 3.111,
   "text": "Quick! Keep the change. It's going to be worthless soon anyway.",
   "textSha256": "831f608fea87f048a0d0a0bfa93d93f889b2d903bfaeceb9747a4fda82828bc2",
   "key": "3f02fb22882e1c8188db734e91e55e64a429fccacb56c3d616e6dd506330a37f",
   "fileSha256": "0241e179c3dc373f9cfad110477baae7201ae5e8c107d5c35b81fa4d5aa3a619"
  },
  {
   "id": "customer_fast_11",
   "speaker": "customer",
   "file": "customer_fast_11.ogg",
   "seconds": 2.734,
   "text": "Great, it's still warm. Unlike the job market.",
   "textSha256": "cadba1438f049b04f69eafd875f4c926e0f42de35685702e949de08d405a7107",
   "key": "0c5cc02ae0923025cc2a9080ed2ba3e9903292e8e3833fde823a70f722c255cc",
   "fileSha256": "ee25db3cb9d0a6191f89af9874eba591f9e7c10d7890c3d66324814dbea6f20e"
  },
  {
   "id": "customer_fast_12",
   "speaker": "customer",
   "file": "customer_fast_12.ogg",
   "seconds": 3.729,
   "text": "You beat my fridge's estimate. It's very disappointed in itself.",
   "textSha256": "d603941bdd6748e3cb6ff7738a2d6b632f13b323d3dc2e9094e32c82e4a45218",
   "key": "d7c5d9dcac05d7f3e303a954895630837fb43c5f0100956d4fcaf7fe952ad0b5",
   "fileSha256": "b63e04a5613300f3efcb14d4bc854517927c12cf573156cca7e065fce5dd2564"
  },
  {
   "id": "customer_ok_1",
   "speaker": "customer",
   "file": "customer_ok_1.ogg",
   "seconds": 3.008,
   "text": "Thanks. About as warm as the economy, but it'll do.",
   "textSha256": "2edaf283a71241599a7bff744529ae688240bc65b481836b170bacfebd524dca",
   "key": "7b544fb68f182718e22560253cb91e8947ef60c62b554fe9fe6ef4674a66663d",
   "fileSha256": "8284ea7ba3f72ee9fdb149c1ef3e1109d5a07cb5e4127b4ac3320b7c8d84f134"
  },
  {
   "id": "customer_ok_2",
   "speaker": "customer",
   "file": "customer_ok_2.ogg",
   "seconds": 3.535,
   "text": "Right on time, more or less. That's more than the bus manages.",
   "textSha256": "5aa7d882de80cd604ef6029cc5de207b10424ea8d4de9eb668fd8f48b5f49040",
   "key": "b70d03ecabb3e7d6b3c125a530307b932d52d6793b5ff103a1e746ad5aa15266",
   "fileSha256": "ca3bac165510e676b164c7f804c74683e25e41b1ee80af391f8be5f261aed105"
  },
  {
   "id": "customer_ok_3",
   "speaker": "customer",
   "file": "customer_ok_3.ogg",
   "seconds": 3.649,
   "text": "Fine, fine. Leave it by the door, next to my unemployment letter.",
   "textSha256": "3a0a649f92b7e782afd9c7896845199d08f4b1b72c28325c8506b8e71a20a889",
   "key": "358a5fcbe27cce58d8dd725b3345a361935b3aeb1a4e1b17546f40142ffa42a1",
   "fileSha256": "273f6532fa4f19dea0f8cf6d75443a34223cb1d0617902d67d58abf0d1e7bec7"
  },
  {
   "id": "customer_ok_4",
   "speaker": "customer",
   "file": "customer_ok_4.ogg",
   "seconds": 3.047,
   "text": "Okay. The app gave you three stars. I gave you four.",
   "textSha256": "469fc082b45cffd1a29f0abce4d50b9231f578a8236b238a5daac01944fe22ee",
   "key": "b80c936e5af4a94f1771d10465381f8e14bed18879c133cf8300d174d843b999",
   "fileSha256": "c969616966f490870a52dfe093e2748f148e845a84a96cf40b31ec0c303cb303"
  },
  {
   "id": "customer_ok_5",
   "speaker": "customer",
   "file": "customer_ok_5.ogg",
   "seconds": 3.062,
   "text": "Thanks. I'd tip more, but the benefits office closed.",
   "textSha256": "c216b9534524d5cb7b900f9ded6e9f8dd23b29831a75352bcd9adf306026c785",
   "key": "50c9d4f727f71b5007946ac73660c60ecf59be51304a9ad9e279f1394cad5a99",
   "fileSha256": "f039d7be0dc3a5f939c5f46de3754636305d3cfdddeb1c7de9dc78334de21c7b"
  },
  {
   "id": "customer_ok_6",
   "speaker": "customer",
   "file": "customer_ok_6.ogg",
   "seconds": 3.208,
   "text": "Not bad. My old company's chatbot would have taken longer.",
   "textSha256": "1bb0ebbdb48abc96651011686146f36a58e2f508e962a02e742649e5c87f97a4",
   "key": "6058addb228229421e3704c65380f6fb25bea70396a18dcdda6a2115fcaeadc6",
   "fileSha256": "b220760ad2058e50c87d14205a0caa24854651822534dc45ea9f1ed075cd0c74"
  },
  {
   "id": "customer_ok_7",
   "speaker": "customer",
   "file": "customer_ok_7.ogg",
   "seconds": 4.359,
   "text": "It's pizza and it's here. Low bar in 2027, but you cleared it.",
   "textSha256": "3569a6ea3d93545054533efa333a58c917f860de83fe926f08384db351bf9254",
   "key": "63214a446435ef3e35f5744b0a0d4910c6268509bd9c5e6b1c091895cde4e5c1",
   "fileSha256": "150b6a619034ad7e4077b7b2c0ccdfd8968ea3c5cd3ca0bc458f4495d59f2ce3"
  },
  {
   "id": "customer_ok_8",
   "speaker": "customer",
   "file": "customer_ok_8.ogg",
   "seconds": 3.351,
   "text": "Thank you. Mind the stairs, the landlord sold the handrail.",
   "textSha256": "d462b8f681b7f092286754c8a5a6fd1bdb4d0c2098f11b0a01ffe8a546e53a31",
   "key": "c6933d891af67469a1a25f91a38da455cfe90caef04b9bad0d7c0f0e5d14393c",
   "fileSha256": "ad96550939ec4f7b36c69e3d569d1dbf71c43772cb524c9214639bba5b9f23d2"
  },
  {
   "id": "customer_ok_9",
   "speaker": "customer",
   "file": "customer_ok_9.ogg",
   "seconds": 3.299,
   "text": "Good enough. Everyone's a courier now, you know. Even my dentist.",
   "textSha256": "5d2a678443419a54b41a91dfdb4fc61588276801baf053512e1fb1f56e8a57bb",
   "key": "7ccecf22b85eed88867047d8de0355e8bfbf9170b11e7c30a2e334ef139ae3e0",
   "fileSha256": "fd88a6db862bd18784e813925e17df85c5d92a53b67ffed15520c6891eacdd35"
  },
  {
   "id": "customer_ok_10",
   "speaker": "customer",
   "file": "customer_ok_10.ogg",
   "seconds": 2.786,
   "text": "Thanks. Lukewarm, like the river in February.",
   "textSha256": "2604a1b62fc181f7107e6fd4087055738afbbb607085cfe1a0abe8f8c5d0cb84",
   "key": "e925d531b3f03654a5eafde4d23d8c48dedf856df4aced1713c9d1a63a8c0c3d",
   "fileSha256": "5b0980f88ab3950f6d0161e78d8215b631e4248ea3515371c85b4d3421a723bc"
  },
  {
   "id": "customer_ok_11",
   "speaker": "customer",
   "file": "customer_ok_11.ogg",
   "seconds": 2.739,
   "text": "Here you go. Don't spend it all on courier permits.",
   "textSha256": "aadb716b64250ea44dea6f898afa995be46fb4ac29beb0d82c34e76880b5fbba",
   "key": "5a0bada3bdfe9d71496dcfd719d9bb1ed8fa8780da3795c5015736c30bca80e0",
   "fileSha256": "a0695c4f964e3e9a86e9f1c330248a4580e648198af4c8d01e26fe66d67c04ed"
  },
  {
   "id": "customer_ok_12",
   "speaker": "customer",
   "file": "customer_ok_12.ogg",
   "seconds": 2.855,
   "text": "Acceptable. I'll leave a review the robots can read.",
   "textSha256": "c34cdcb5063ee31ea7b47a1487f3bd65d1328b0d06778eaa73e18cec1e6c96c9",
   "key": "3b84359a533ef88e9de3b71b145bff6e798b5d17e2ee57e0479cfa8c87cb2798",
   "fileSha256": "6a1fdca1aee2b2ca8eee2e6744c1577aa86826d7033ad5a93f82344222cb31bf"
  },
  {
   "id": "customer_slow_1",
   "speaker": "customer",
   "file": "customer_slow_1.ogg",
   "seconds": 3.262,
   "text": "Finally. I almost asked the delivery drone to adopt me.",
   "textSha256": "dd168dae96dcf2b78fad219c18f2d5cded74451dc67acd496d5ca19cd5492a9f",
   "key": "b787c97b6286d60687acdee4ac6adf42273674d77624f3d5264de2e92057d4b8",
   "fileSha256": "b903e4af77ae36d4daf3a77cd4a5cebcc3f18059f07587be9780ed22fa59335a"
  },
  {
   "id": "customer_slow_2",
   "speaker": "customer",
   "file": "customer_slow_2.ogg",
   "seconds": 2.281,
   "text": "Cold. Just like the river in January.",
   "textSha256": "67739c0f7de17274788b1a017d0fb257429d77f9331f87a48fe9cdb882d33e45",
   "key": "eef94e7780bceea538fc9d14db0652b8ede2efa0838938e080dbe64e19b50cf3",
   "fileSha256": "5cdf4d67d01d79743ed5111979706e55e45acb7c7d9de19ccd2160cfde24e95c"
  },
  {
   "id": "customer_slow_3",
   "speaker": "customer",
   "file": "customer_slow_3.ogg",
   "seconds": 2.162,
   "text": "Did you stop for a swim in the river on the way?",
   "textSha256": "87fc41d1441c0fca2186aef3ec369264f58808b6497288f6bf2ce4bebccf8c94",
   "key": "2df9f9e99c26001ab69f93ae5db2b28e6281f936c0784c1cc22298e41712c55f",
   "fileSha256": "e67dc6465425f39169ec5782d64549c7a7de63e93ac026bd11a98e4d2a704b3e"
  },
  {
   "id": "customer_slow_4",
   "speaker": "customer",
   "file": "customer_slow_4.ogg",
   "seconds": 2.768,
   "text": "My cat starved twice while I waited. No tip.",
   "textSha256": "ccdc75dd4d5f485969d60510eb2030d41302ccc683d90cc1ee92d282d185e894",
   "key": "0abdcd084118e2a310091175b3dc6b8a90dd872fce7c884d3b6c2ca53cd651f9",
   "fileSha256": "3480e269245f22663184bea288994fb038e5e8aae6579caec19e5edcc9b306f8"
  },
  {
   "id": "customer_slow_5",
   "speaker": "customer",
   "file": "customer_slow_5.ogg",
   "seconds": 2.415,
   "text": "The cheese has set. So has my opinion of you.",
   "textSha256": "c963aa94b1a7f242a7a8f86abeea82328984c9004b0f2c68dbd875ab3daa687a",
   "key": "86b09aec8b8738651eac5520d2fb013543ccf60326032a27e877ba9e28676650",
   "fileSha256": "d68431c5c08ed7b218a5ba20760cf17a3e90878d8b28ab120451716979d70e7c"
  },
  {
   "id": "customer_slow_6",
   "speaker": "customer",
   "file": "customer_slow_6.ogg",
   "seconds": 2.697,
   "text": "I could have walked to Helsinki and back. No tip.",
   "textSha256": "27b590af568cde6065bdefde188d73940a870fa45a48a71dc3077a406697c611",
   "key": "240ea89cdc156e7cf633eb222889c8523bc24a3664a50342c21e6ff6bfba2b77",
   "fileSha256": "1008a726801090200cffc24740b316ccb4ade6c3606813cd7d012a9f73bb2d2e"
  },
  {
   "id": "customer_slow_7",
   "speaker": "customer",
   "file": "customer_slow_7.ogg",
   "seconds": 3.162,
   "text": "The robots are slower than you, but at least they apologise.",
   "textSha256": "4531e6bb047a721f40ebf42d8123e384548de9f2af9b634f01ba016be11823f1",
   "key": "52c1e8c41f59da90bed961287118018ecac32a0fef2d5186ddea0b9ed42c0321",
   "fileSha256": "3e1f8401ee9f6eb0b9aae6ed7fb874346f3f7624933fdc118c3fe7ac32ee7dd5"
  },
  {
   "id": "customer_slow_8",
   "speaker": "customer",
   "file": "customer_slow_8.ogg",
   "seconds": 2.592,
   "text": "Is this pizza or archaeology? Lovely.",
   "textSha256": "5a841216b7501c3be03ce6bb8b64d70b703ddb37b8dc89781bb36f3dee81d2b4",
   "key": "4c451a0ffd35a806efa15a9a9faf5009de357411480d337d61091c8176661f44",
   "fileSha256": "3ab31b58b7ccf81a630047fad9ebc018c5fb0ea67353830efb74440969774049"
  },
  {
   "id": "customer_slow_9",
   "speaker": "customer",
   "file": "customer_slow_9.ogg",
   "seconds": 3.099,
   "text": "Cold pizza on a cold evening. Very Turku of you.",
   "textSha256": "d2910d448122884655db6862adb1538dcca048044dcd0c3394a183872dd065f0",
   "key": "b807f7d2ef149197658abb8e5c47a46d57852fe963a91085141e5804c3b41a28",
   "fileSha256": "42488abc418f882d7dc3fb9f333dc0f04808679de0d936a81b70b733547fb9a6"
  },
  {
   "id": "customer_slow_10",
   "speaker": "customer",
   "file": "customer_slow_10.ogg",
   "seconds": 2.659,
   "text": "I aged a year in that time. My pension didn't.",
   "textSha256": "ee9a3296b733116a178df71d5cf31b679c1970b00090218e30bd699fb7551325",
   "key": "fd2dffcdcf4ee5aa71887cf8a5ab74c3916407a47f04e014fc81bd3b1ab37bbe",
   "fileSha256": "5be8e3a4f4f83be602e46e5d10daace892afdfdb921a788175fe99ead651f246"
  },
  {
   "id": "customer_slow_11",
   "speaker": "customer",
   "file": "customer_slow_11.ogg",
   "seconds": 2.159,
   "text": "You're lucky the robots are on strike today.",
   "textSha256": "3b9c61318f5ee1d74fa37047d874b8cacbf0d33ce4d9c75abf5bb0034b957ea0",
   "key": "fd1d2f713d937a9cb925ba43e64ee953f432460741f6cbfe5f453b83b74b9654",
   "fileSha256": "3b6bbae516bbc061eadac83f926d086bcf818181cdf961f97b3e614517a223c6"
  },
  {
   "id": "customer_slow_12",
   "speaker": "customer",
   "file": "customer_slow_12.ogg",
   "seconds": 3.172,
   "text": "Ah, the courier. I'd given up on you and on humanity.",
   "textSha256": "40daffc1f8a74d4c324467e40e23adf4383eb0a2ab1204e02ae3691e7c0041b9",
   "key": "ae4dfe79ec7f553d750d8fd5cc0640a69c7e3113c41591eca2575b4d7065021d",
   "fileSha256": "381f5a6977897b93234da99c5017df835fdd8e8712276e21e991733ac4ae2636"
  }
 ]
}
