{
  "name": "turku3d-game",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --strictPort",
    "dev-tiles": "node scripts/make-dev-tiles.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "probe": "node scripts/probe-page.mjs",
    "prepare-character": "node scripts/prepare-character.mjs",
    "test:vehicle-node": "node --test tests/headless/vehicle.test.ts",
    "prepare-car": "node scripts/prepare-car.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.21.0",
    "3d-tiles-renderer": "0.5.3",
    "meshoptimizer": "1.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "ktx2-encoder": "^0.4.2",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.5"
  }
}
