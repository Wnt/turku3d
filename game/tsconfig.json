{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck.tsbuildinfo",
    "allowJs": true
  },
  "include": [
    "src",
    "tests/unit",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.tile.config.ts",
    "tests/e2e",
    "tests/e2e-tile",
    "playwright.render.config.ts",
    "playwright.render-dev.config.ts",
    "tests/render",
"vite.ground.config.ts",
    "tests/e2e-playtest",
    "playwright.playtest.config.ts",
    "tests/e2e-hotswap",
    "playwright.hotswap.config.ts"
  ]
}
