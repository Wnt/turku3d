[Unit]
Description=city.madekivi.fi web (tools/share/oci/Caddyfile): the game, tiles and scenery from disk, multiplayer and scenery catalogue on this host
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/citylab/bin/caddy run --config /srv/turku3d/citylab/oci/Caddyfile --adapter caddyfile
ExecReload=/home/ubuntu/citylab/bin/caddy reload --config /srv/turku3d/citylab/oci/Caddyfile --adapter caddyfile --address localhost:2020
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=1048576
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
