# Installed by tools/share/deploy.sh. The public share's only listener: the game, /pointcloud (COPC), /coarse (via
# city-tiles), /cities/<name>/coarse (the other cities' tile services named in cities.json, hot-read) and the multiplayer socket and scores (via city-mp), GET/HEAD only (serve-dist.mjs --public). No edit
# uploads: the editor (?editor=1) keeps its sessions in the browser (docs/handover/editor.md).
[Unit]
Description=Turku3D city share: public game server on 127.0.0.1:7780
After=city-tiles.service city-mp.service city-web.socket
Wants=city-tiles.service city-mp.service
Requires=city-web.socket

[Service]
# The share answers players first: tile builds on this host run at CPUWeight 20 (tools/cities/run.sh), the
# other user services at the default 100.
CPUWeight=1000
Type=simple
# The release whose code it runs (deploy.sh moves `web` only when that code changes).
WorkingDirectory=%h/turku3d-local/city/web/src
Environment=NODE_ENV=production TURKU3D_WORK=%h/turku3d-local/city/work
ExecStart=/usr/bin/node tools/dev/serve-dist.mjs --public --host 127.0.0.1 --port 7780 --root %h/turku3d-local/city/current/dist --coarse http://127.0.0.1:7781 --mp http://127.0.0.1:7782 --mount /pointcloud=/bulk/turku3d/lidarpc/copc --cities %h/turku3d-local/city/cities.json
Restart=always
RestartSec=3
# SIGTERM drains the requests in flight (at most 4 s, tools/dev/systemdListen.mjs) before the process exits.
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
