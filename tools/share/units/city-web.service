# Installed by tools/share/deploy.sh. The public share's only listener: the game, /pointcloud (COPC), /coarse (via
# city-tiles) and the multiplayer socket and scores (via city-mp), GET/HEAD only (serve-dist.mjs --public).
[Unit]
Description=Turku3D city share: public game server on 127.0.0.1:7780
After=city-tiles.service city-mp.service
Wants=city-tiles.service city-mp.service

[Service]
Type=simple
WorkingDirectory=%h/turku3d-local/city/current/src
Environment=NODE_ENV=production TURKU3D_WORK=%h/turku3d-local/city/work
ExecStart=/usr/bin/node tools/dev/serve-dist.mjs --public --host 127.0.0.1 --port 7780 --root %h/turku3d-local/city/current/dist --coarse http://127.0.0.1:7781 --mp http://127.0.0.1:7782 --mount /pointcloud=/bulk/turku3d/lidarpc/copc
Restart=always
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
