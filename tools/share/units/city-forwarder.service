# Installed by tools/share/deploy.sh. Outbound tunnel to the forwarder; the token is the existing Turku env file.
[Unit]
Description=Turku3D city share: tunnel https://city.lab.madekivi.fi -> city-web
After=city-web.service
Wants=city-web.service

[Service]
# The share answers players first: tile builds on this host run at CPUWeight 20 (tools/cities/run.sh), the
# other user services at the default 100.
CPUWeight=1000
Type=simple
EnvironmentFile=%h/.config/turku3d/forwarder.env
ExecStart=%h/turku3d-mp/bin/forwarder-agent-linux-amd64 --server tunnel.lab.madekivi.fi --tunnel city:http:city.lab.madekivi.fi:7780
Restart=always
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
