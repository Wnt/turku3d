[Unit]
Description=Turku3D draft producer slot %i
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/turku3d-drafts/slot-%i.env
ExecStart=/bin/bash -c 'exec "$TURKU3D_DRAFT_SOURCE/tools/remote-drafts/run.sh" python tools/remote-drafts/public.py'
Restart=on-failure
RestartSec=3
Nice=10
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0027
StandardOutput=append:%h/turku3d-drafts/reports/service.log
StandardError=append:%h/turku3d-drafts/reports/service.log

[Install]
WantedBy=default.target
