{
	admin off
	auto_https off
}

(draft_cors) {
	@draftCors header_regexp Origin ^(https://wnt\.github\.io|http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?)$
	header @draftCors {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers If-None-Match
		Access-Control-Expose-Headers "ETag, Retry-After"
		Timing-Allow-Origin {http.request.header.Origin}
		Vary Origin
		defer
	}
}

http://:7764 {
	bind 127.0.0.1
	encode {
		# Cached transfers share CPU with four build workers. Prefer encoder
		# throughput over size: default gzip exceeded the 10-player p95 budget.
		zstd fastest
		gzip 1
		match {
			header Content-Type application/json*
			header Content-Type application/octet-stream*
			header Content-Type model/gltf-binary*
		}
	}
	handle_path /facades/* {
		root * /srv/turku3d/data/facade-assets
		@cors header_regexp Origin ^(https://wnt\.github\.io|http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?)$
		header @cors Access-Control-Allow-Origin {http.request.header.Origin}
		header Vary Origin
		header Cross-Origin-Resource-Policy cross-origin
		header Cache-Control "public, max-age=30, must-revalidate"
		file_server
	}
	handle /coarse/* {
		import draft_cors
		route {
			@forbiddenOrigin {
				header Origin *
				not header_regexp Origin ^(https://wnt\.github\.io|http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?)$
			}
			respond @forbiddenOrigin 403
			header {
				Retry-After 5
				defer
				match {
					status 408 429 5xx
				}
			}
			@preflight method OPTIONS
			respond @preflight 204
			# Published content-addressed bytes outlive producer slots and never need
			# scheduler admission. Mutable manifests/aliases always remain in Python.
			@immutable {
				method GET HEAD
				# Same public tile bounds as config.json; shared payloads have no tile.
				path_regexp asset ^/coarse/(?:t0_-?(?:[0-9]|1[0-9]|2[0-4])_-?(?:[0-9]|1[0-9]|2[0-4])/(?:vis\.|roads\.|bundle\.|col/c_-?[0-9]+_-?[0-9]+\.)|shared/)([0-9a-f]{64})\.(?:glb|col|json|ktx2|bin)$
			}
			handle @immutable {
				root * /srv/turku3d/work/coarse
				uri strip_prefix /coarse
				header {
					Cache-Control "public, max-age=31536000, immutable"
					Cross-Origin-Resource-Policy cross-origin
					X-Content-Type-Options nosniff
					ETag `"{re.asset.1}"`
				}
				@glb path *.glb
				header @glb Content-Type model/gltf-binary
				@binary path *.col *.bin
				header @binary Content-Type application/octet-stream
				@ktx path *.ktx2
				header @ktx Content-Type image/ktx2
				file_server
			}
			handle {
				import /home/ubuntu/turku3d-drafts/draft-upstream.caddy
			}
		}
	}
	handle_errors {
		import draft_cors
		header -ETag
		header Retry-After 5
		header Cache-Control no-store
		respond "draft unavailable" {err.status_code}
	}
	handle {
		reverse_proxy 127.0.0.1:7700
	}
}
