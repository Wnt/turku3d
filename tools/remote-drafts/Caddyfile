{
	admin off
	auto_https off
}

http://:7764 {
	bind 127.0.0.1
	encode zstd gzip {
		match {
			header Content-Type application/json*
			header Content-Type application/octet-stream*
			header Content-Type model/gltf-binary*
		}
	}
	handle_path /facades/* {
		root * /srv/turku3d/data/facade-assets
		@cors header_regexp Origin ^(https://wnt\.github\.io|http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?)$
		header @cors Access-Control-Allow-Origin {http.request.header.Origin}
		header Vary Origin
		header Cross-Origin-Resource-Policy cross-origin
		header Cache-Control "public, max-age=30, must-revalidate"
		file_server
	}
	handle /coarse/* {
		import /home/ubuntu/turku3d-drafts/draft-upstream.caddy
	}
	handle {
		reverse_proxy 127.0.0.1:7700
	}
}
