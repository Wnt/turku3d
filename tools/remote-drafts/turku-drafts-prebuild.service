[Unit]
Description=Warm only Turku3D startup tiles
After=turku-drafts-proxy.service
Requires=turku-drafts-proxy.service

[Service]
Type=oneshot
ExecStart=%h/turku3d-drafts/repo/tools/remote-drafts/run.sh python scripts/dev/host_slots.py build python tools/remote-drafts/prebuild.py
Nice=15
TimeoutStartSec=infinity
KillMode=control-group
NoNewPrivileges=true
UMask=0027
StandardOutput=append:%h/turku3d-drafts/reports/prebuild.log
StandardError=append:%h/turku3d-drafts/reports/prebuild.log

[Install]
WantedBy=default.target
