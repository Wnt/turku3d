{
  "schema": "turku-families/1",
  "about": "Material families of the world pipeline and the parameters each accepts (docs/design/render-readiness.md, M1). A material is one flat row of these parameters. Types: colour (#rrggbb), number, boolean, id (a texture-library or atlas id) or a list of enum values. The owner keeps its rows current; check-readiness lists families and parameters that are not here. A family with params null has not declared its parameters yet.",
  "common": {
    "weathering": "number",
    "uv": ["metres", "atlas"],
    "coverage": "number"
  },
  "families": {
    "flat": { "owner": "w2-core", "params": { "colour": "colour", "color": "colour", "roughness": "number", "metalness": "number" } },

    "plaster": { "owner": "w2-buildings", "params": { "colour": "colour", "finish": ["smooth", "fine", "rough", "roughcast", "scored"], "relief": "id", "course_m": "number" } },
