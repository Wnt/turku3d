    "weatherboard": { "owner": "w2-buildings", "params": { "colour": "colour", "orientation": ["horizontal", "vertical"], "profile": ["bevel", "shiplap", "tongue_groove", "board_batten", "beaded"], "scale_m": "number" } },
    "log": { "owner": "w2-buildings", "params": { "colour": "colour", "scale_m": "number" } },
    "granite": { "owner": "w2-buildings", "params": { "colour": "colour", "colour2": "colour", "finish": ["ashlar", "rock_faced", "polished", "slab"], "scale_m": "number", "course_m": "number", "relief": "id" } },
    "stone": { "owner": "w2-buildings", "params": { "colour": "colour", "colour2": "colour", "finish": ["ashlar", "rock_faced", "polished", "slab"], "scale_m": "number", "course_m": "number", "relief": "id" } },
    "rubble": { "owner": "w2-buildings", "params": { "colour": "colour", "colour2": "colour", "scale_m": "number" } },
