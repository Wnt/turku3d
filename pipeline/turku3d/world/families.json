    "ceramic_tile": { "owner": "w2-buildings", "params": { "colour": "colour", "colour2": "colour", "scale_m": "number" } },
    "sheet_metal": { "owner": "w2-buildings", "params": { "colour": "colour", "profile": ["standing_seam", "flat_seam", "corrugated", "cassette"], "scale_m": "number" } },
    "clay_tile": { "owner": "w2-buildings", "params": { "colour": "colour", "profile": ["pantile", "flat_tile"], "scale_m": "number" } },
