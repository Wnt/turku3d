    "copper": { "owner": "w2-buildings", "params": { "colour": "colour", "finish": ["matt", "gloss", "weathered"] } },
    "metal": { "owner": "w2-buildings", "params": { "colour": "colour", "finish": ["matt", "gloss", "weathered"] } },
    "painted_wood": { "owner": "w2-buildings", "params": { "colour": "colour", "finish": ["matt", "gloss", "weathered"] } },
    "glass": { "owner": "w2-buildings", "params": { "colour": "colour", "finish": ["matt", "gloss", "weathered"], "tint": "colour", "reflectivity": "number", "curtains": "number", "blinds": "number", "interior": ["dwelling", "office", "shop", "stair", "dark", "frosted"] } },

    "asphalt": { "owner": "w2-street", "params": { "tone": "number", "tint": "colour" } },
