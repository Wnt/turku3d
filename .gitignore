*.exr
qa/renders/
game/test-results/
game/playwright-report/
screenshots/

# Secrets / tokens (e.g. ~/.config/turku3d/mapillary.token is outside the repo; never copy it here)
*.token
*client_secret*
.env
.env.*
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local quality gate caches (never shared between worktrees)
.cache/
