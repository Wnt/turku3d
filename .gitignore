# Dependencies / envs
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/
.mypy_cache/

# Bulk data and build output (bulk data lives on osgallery-dev:~/turku3d/data)
/data/
dist/
*.laz
*.las
*.copc.laz
# Generated test points only (PDAL from random values, no survey data): render/pointCloud unit tests.
!/game/tests/fixtures/pointcloud/synthetic.copc.laz
*.ply
*.tif
*.tiff

# Generated images / renders / texture outputs (assets live in data/, manifests are committed)
textures/out/
textures/library/images/
textures/run/out/
*.ktx2
!game/public/scenes/shared/*.ktx2
*.exr
qa/renders/
game/test-results/
game/playwright-report/
screenshots/

# Secrets / tokens (e.g. ~/.config/turku3d/mapillary.token is outside the repo; never copy it here)
*.token
*client_secret*
.env
.env.*
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Local quality gate caches (never shared between worktrees)
.cache/
*.tsbuildinfo
.eslintcache

# Generated semantic-scene assets live in the immutable host content store.
/game/public/scenes/shared/
# Compiled scenes are generated data (the office scene is about 160 MB): never tracked.
# Their history was removed on 2026-11-15; a fresh checkout copies them from the content store or the trunk worktree.
/game/public/scenes/*.scene.json
