{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/dev/serve-dist.mjs",
        "tools/dev/serve-dist.test.mjs",
        "pipeline/turku3d/col/meshopt_bridge.mjs",
        "pipeline/turku3d/package/visual.mjs"
      ],
      "project": [
        "tools/dev/*.mjs",
        "pipeline/**/*.mjs"
      ]
    },
    "game": {
      "entry": [
        "src/physics/worker.ts",
        "tests/**/*.ts",
        "*.config.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "scripts/*.mjs",
        "*.config.ts"
      ],
      "playwright": {
        "config": [
          "playwright*.config.ts"
        ]
      }
    },
    "tools/validator": {
      "entry": [
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "qa/render": {
      "entry": [
        "test/**/*.mjs"
      ],
      "project": [
        "**/*.mjs"
      ]
    }
  }
}
